# LLMVECT Environment Variables\n# Copy this file to .env and fill in your API keys\n\n# Admin password (optional - random 16-char password is generated on first start)\n# ADMIN_PASSWORD=\n\n# ===== Chinese LLM Providers =====\n# Alibaba (Qwen series)\nDASHSCOPE_API_KEY=\n\n# Baidu (ERNIE series)\nBAIDU_API_KEY=\n\n# Tencent (Hunyuan series)\nTENCENT_API_KEY=\n\n# ByteDance (Doubao series)\nDOUBAO_API_KEY=\n\n# iFlytek (Spark series)\nSPARK_API_KEY=\n\n# Xiaomi (MiLM)\nXIAOMI_API_KEY=\n\n# Zhipu (GLM series)\nZHIPU_API_KEY=\n\n# Moonshot (Kimi)\nMOONSHOT_API_KEY=\n\n# DeepSeek\nDEEPSEEK_API_KEY=\n\n# Baichuan\nBAICHUAN_API_KEY=\n\n# MiniMax\nMINIMAX_API_KEY=\n\n# 01.AI (Yi series)\nYI_API_KEY=\n\n# StepFun (Step series)\nSTEPFUN_API_KEY=\n\n# Meituan\nMEITUAN_API_KEY=\n\n# Skywork\nSKYWORK_API_KEY=\n\n# SiliconFlow\nSILICONFLOW_API_KEY=\n\n# 360 (Zhinao)\n360_API_KEY=\n\n# Huawei (Pangu)\nHUAWEI_API_KEY=\n\n# InternLM\nINTERNLM_API_KEY=\n\n# Kuaishou (Kling)\nKUAISHOU_API_KEY=\n\n# ModelBest\nMODELBEST_API_KEY=\n\n# SenseNova\nSENSENOVA_API_KEY=\n\n# NetEase (Youdao)\nWANGYI_API_KEY=\n\n# ===== Global LLM Providers =====\n# OpenAI\nOPENAI_API_KEY=\n\n# Anthropic\nANTHROPIC_API_KEY=\n\n# Google (Gemini)\nGOOGLE_API_KEY=\n\n# Mistral\nMISTRAL_API_KEY=\n\n# Cohere\nCOHERE_API_KEY=\n\n# Groq\nGROQ_API_KEY=\n\n# xAI (Grok)\nXAI_API_KEY=\n\n# NVIDIA\nNVIDIA_API_KEY=\n\n# Perplexity\nPERPLEXITY_API_KEY=\n\n# Reka\nREKA_API_KEY=\n\n# AI21 Labs\nAI21_API_KEY=\n\n# Together AI\nTOGETHER_API_KEY=\n\n# Upstage\nUPSTAGE_API_KEY=\n\n# Writer\nWRITER_API_KEY=\n\n# SambaNova\nSAMBANOVA_API_KEY=\n